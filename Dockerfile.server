# Use Python slim image
FROM python:3.11-slim

WORKDIR /app/backend

# Install dependencies
COPY backend/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Copy backend source
COPY backend/ .

ENV PORT=3000

EXPOSE 3000

CMD ["sh", "-c", "uvicorn main:sio_app --host 0.0.0.0 --port ${PORT}"]
